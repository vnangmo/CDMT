// ===================================
// CDMT GLOBAL (MINISTERIAL CEILINGS)
// ===================================

model CDMTGlobalScenario {
  id           String  @id @default(uuid())
  scenarioCode String  @unique
  name         String
  description  String?

  // Données de référence
  fiscalYear       Int // Année fiscale cible
  macroFrameworkId String // Lien vers cadre macro
  trendConfigId    String? // Lien vers config tendanciel

  // Marge fiscale disponible (calculée depuis macro)
  fiscalMarginY1 Decimal @db.Decimal(15, 2)
  fiscalMarginY2 Decimal @db.Decimal(15, 2)
  fiscalMarginY3 Decimal @db.Decimal(15, 2)

  // Marge de manœuvre par catégorie économique (Guide Méthodologique CDMT, p.20)
  // Formule: Marge = Dépenses CBMT par catégorie - Tendanciel par catégorie
  // Personnel
  marginPersonnelY1 Decimal @default(0) @db.Decimal(15, 2)
  marginPersonnelY2 Decimal @default(0) @db.Decimal(15, 2)
  marginPersonnelY3 Decimal @default(0) @db.Decimal(15, 2)
  // Biens et Services
  marginGoodsServicesY1 Decimal @default(0) @db.Decimal(15, 2)
  marginGoodsServicesY2 Decimal @default(0) @db.Decimal(15, 2)
  marginGoodsServicesY3 Decimal @default(0) @db.Decimal(15, 2)
  // Transferts
  marginTransfersY1 Decimal @default(0) @db.Decimal(15, 2)
  marginTransfersY2 Decimal @default(0) @db.Decimal(15, 2)
  marginTransfersY3 Decimal @default(0) @db.Decimal(15, 2)
  // Investissements internes
  marginInternalInvestmentY1 Decimal @default(0) @db.Decimal(15, 2)
  marginInternalInvestmentY2 Decimal @default(0) @db.Decimal(15, 2)
  marginInternalInvestmentY3 Decimal @default(0) @db.Decimal(15, 2)
  // Investissements externes
  marginExternalInvestmentY1 Decimal @default(0) @db.Decimal(15, 2)
  marginExternalInvestmentY2 Decimal @default(0) @db.Decimal(15, 2)
  marginExternalInvestmentY3 Decimal @default(0) @db.Decimal(15, 2)

  // Totaux (calculés)
  totalBaselineY1 Decimal @default(0) @db.Decimal(15, 2)
  totalBaselineY2 Decimal @default(0) @db.Decimal(15, 2)
  totalBaselineY3 Decimal @default(0) @db.Decimal(15, 2)

  totalMeasuresY1 Decimal @default(0) @db.Decimal(15, 2)
  totalMeasuresY2 Decimal @default(0) @db.Decimal(15, 2)
  totalMeasuresY3 Decimal @default(0) @db.Decimal(15, 2)

  totalAllocatedY1 Decimal @default(0) @db.Decimal(15, 2)
  totalAllocatedY2 Decimal @default(0) @db.Decimal(15, 2)
  totalAllocatedY3 Decimal @default(0) @db.Decimal(15, 2)

  totalCeilingY1 Decimal @default(0) @db.Decimal(15, 2)
  totalCeilingY2 Decimal @default(0) @db.Decimal(15, 2)
  totalCeilingY3 Decimal @default(0) @db.Decimal(15, 2)

  // Enhanced workflow fields (5-level workflow)
  status          String    @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, VALIDATED, APPROVED, REJECTED, ACTIVE, ARCHIVED
  workflowStage   String? // Current validation stage/role
  isActive        Boolean   @default(false) // Un seul scénario actif à la fois
  activatedAt     DateTime?
  activatedBy     String?
  submittedAt     DateTime?
  submittedBy     String?
  reviewStartedAt DateTime?
  reviewStartedBy String?
  validatedAt     DateTime?
  validatedBy     String?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?
  createdBy       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  macroFramework MacroFramework     @relation(fields: [macroFrameworkId], references: [id])
  trendConfig    TrendBudgetConfig? @relation(fields: [trendConfigId], references: [id])

  policyMeasures      PolicyMeasure[]
  marginAllocations   MarginAllocation[]
  ministerialCeilings MinisterialCeiling[]

  @@map("cdmt_global_scenarios")
}

model PolicyMeasure {
  id         String @id @default(uuid())
  scenarioId String
  ministryId String

  // Identification
  measureCode String? // Code optionnel (ex: "RH-2024-01")
  measureName String
  description String?
  category    String? // "PERSONNEL", "INVESTMENT", "OPERATION", "OTHER"

  // Type de mesure selon le guide méthodologique CDMT (page 18)
  // TYPE_1 = Mesures centrales (niveau gouvernemental/Ministère des Finances)
  // TYPE_2 = Mesures sectorielles (niveau ministériel)
  measureType String @default("TYPE_1") // TYPE_1 ou TYPE_2

  // Montants par année (peuvent être positifs ou négatifs)
  amountY1 Decimal @db.Decimal(15, 2)
  amountY2 Decimal @db.Decimal(15, 2)
  amountY3 Decimal @db.Decimal(15, 2)

  // Métadonnées
  justification String?
  source        String? // Source de la mesure

  // Enhanced workflow fields (5-level workflow)
  status          String    @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, VALIDATED, APPROVED, REJECTED
  workflowStage   String? // Current validation stage/role
  submittedAt     DateTime?
  submittedBy     String?
  reviewStartedAt DateTime?
  reviewStartedBy String?
  validatedAt     DateTime?
  validatedBy     String?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?
  createdBy       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  scenario CDMTGlobalScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  ministry Ministry           @relation(fields: [ministryId], references: [id])

  @@unique([scenarioId, ministryId, measureCode])
  @@index([scenarioId])
  @@index([ministryId])
  @@map("policy_measures")
}

model MarginAllocation {
  id         String @id @default(uuid())
  scenarioId String
  ministryId String

  // Allocation manuelle de la marge par année
  allocatedY1 Decimal @default(0) @db.Decimal(15, 2)
  allocatedY2 Decimal @default(0) @db.Decimal(15, 2)
  allocatedY3 Decimal @default(0) @db.Decimal(15, 2)

  // Justification et notes
  notes            String?
  allocationMethod String? // "MANUAL", "FORMULA_SUGGESTION" (pour traçabilité)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  scenario CDMTGlobalScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  ministry Ministry           @relation(fields: [ministryId], references: [id])

  @@unique([scenarioId, ministryId])
  @@index([scenarioId])
  @@map("margin_allocations")
}

// ===================================
// SPRINT 5.3: SECTORAL NEW MEASURES & ACTION PLANS
// ===================================

model SectoralMeasure {
  id          String  @id @default(uuid())
  measureCode String  @unique
  name        String
  nameAr      String?
  nameEn      String?
  description String?

  // Polymorphic linkage: ACTION or ACTIVITY
  entityType String // "ACTION" or "ACTIVITY"
  ministryId String
  programId  String?
  actionId   String?
  activityId String?

  // Classification
  category String? // "NEW_PERSONNEL", "NEW_OPERATION", "NEW_INVESTMENT", etc.
  priority Int?

  // Multi-year costing (quantity × unit cost)
  quantityY1  Decimal @default(0) @db.Decimal(15, 2)
  unitCostY1  Decimal @default(0) @db.Decimal(15, 2)
  totalCostY1 Decimal @default(0) @db.Decimal(15, 2)

  quantityY2  Decimal @default(0) @db.Decimal(15, 2)
  unitCostY2  Decimal @default(0) @db.Decimal(15, 2)
  totalCostY2 Decimal @default(0) @db.Decimal(15, 2)

  quantityY3  Decimal @default(0) @db.Decimal(15, 2)
  unitCostY3  Decimal @default(0) @db.Decimal(15, 2)
  totalCostY3 Decimal @default(0) @db.Decimal(15, 2)

  totalCost Decimal @db.Decimal(15, 2)

  // Economic classification
  economicNatureId String?
  fundingSourceId  String?

  // Justification
  justification        String?
  expectedImpact       String?
  performanceIndicator String?

  // Enhanced workflow fields (5-level workflow)
  status          String    @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, VALIDATED, APPROVED, REJECTED
  workflowStage   String? // Current validation stage/role
  submittedAt     DateTime?
  submittedBy     String?
  reviewStartedAt DateTime?
  reviewStartedBy String?
  validatedAt     DateTime?
  validatedBy     String?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?
  integratedAt    DateTime? // Legacy field, kept for compatibility

  fiscalYear Int

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ministry       Ministry        @relation(fields: [ministryId], references: [id])
  program        Program?        @relation(fields: [programId], references: [id])
  action         Action?         @relation(fields: [actionId], references: [id], onDelete: Cascade)
  activity       Activity?       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  economicNature EconomicNature? @relation(fields: [economicNatureId], references: [id])
  fundingSource  FundingSource?  @relation(fields: [fundingSourceId], references: [id])
  actionPlans    ActionPlan[]

  @@index([ministryId])
  @@index([actionId])
  @@index([activityId])
  @@index([fiscalYear])
  @@index([status])
  @@index([economicNatureId])
  @@index([fundingSourceId])
  @@index([ministryId, fiscalYear, status]) // Composite index for common filter combination
  @@index([ministryId, fiscalYear]) // For summary queries
  @@map("sectoral_measures")
}

model ActionPlan {
  id          String  @id @default(uuid())
  planCode    String  @unique
  name        String
  nameAr      String?
  nameEn      String?
  description String?

  sectoralMeasureId String
  ministryId        String
  fiscalYear        Int

  // Timeline
  startDate DateTime?
  endDate   DateTime?
  duration  Int?

  // Objectives
  objectives            String?
  expectedResults       String?
  performanceIndicators Json?

  // Resources
  humanResources       String?
  technicalResources   String?
  institutionalSupport String?

  // Risk management
  risks              Json?
  mitigationMeasures String?

  // Costing (aggregated from activities)
  totalCostY1 Decimal @default(0) @db.Decimal(15, 2)
  totalCostY2 Decimal @default(0) @db.Decimal(15, 2)
  totalCostY3 Decimal @default(0) @db.Decimal(15, 2)
  totalCost   Decimal @default(0) @db.Decimal(15, 2)

  // Enhanced workflow fields (5-level workflow)
  status        String   @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, VALIDATED, APPROVED, REJECTED
  workflowStage String? // Current validation stage/role
  progress      Decimal? @db.Decimal(5, 2)

  responsibleEntity String?
  coordinator       String?

  submittedAt     DateTime?
  submittedBy     String?
  reviewStartedAt DateTime?
  reviewStartedBy String?
  validatedAt     DateTime?
  validatedBy     String?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sectoralMeasure SectoralMeasure      @relation(fields: [sectoralMeasureId], references: [id], onDelete: Cascade)
  ministry        Ministry             @relation(fields: [ministryId], references: [id])
  activities      ActionPlanActivity[]

  @@index([sectoralMeasureId])
  @@index([ministryId])
  @@index([fiscalYear])
  @@index([status]) // Frequently filtered
  @@index([ministryId, fiscalYear]) // Common combination for summary queries
  @@map("action_plans")
}

model ActionPlanActivity {
  id           String  @id @default(uuid())
  activityCode String
  name         String
  description  String?
  actionPlanId String

  orderIndex   Int     @default(0)
  dependencies String?

  // Timeline
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  // Costing (quantity × unit cost)
  quantityY1  Decimal @default(0) @db.Decimal(15, 2)
  unitCostY1  Decimal @default(0) @db.Decimal(15, 2)
  totalCostY1 Decimal @default(0) @db.Decimal(15, 2)

  quantityY2  Decimal @default(0) @db.Decimal(15, 2)
  unitCostY2  Decimal @default(0) @db.Decimal(15, 2)
  totalCostY2 Decimal @default(0) @db.Decimal(15, 2)

  quantityY3  Decimal @default(0) @db.Decimal(15, 2)
  unitCostY3  Decimal @default(0) @db.Decimal(15, 2)
  totalCostY3 Decimal @default(0) @db.Decimal(15, 2)

  totalCost Decimal @db.Decimal(15, 2)

  assignedTo   String?
  resourceType String?
  deliverables Json?

  status   String   @default("PLANNED")
  progress Decimal? @db.Decimal(5, 2)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actionPlan ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)

  @@unique([actionPlanId, activityCode])
  @@index([actionPlanId])
  @@map("action_plan_activities")
}

model WorkflowHistory {
  id String @id @default(uuid())

  // Polymorphic document reference
  documentType String // "SECTORAL_MEASURE", "ACTION_PLAN", "MACRO_FRAMEWORK", etc.
  documentId   String
  documentCode String? // For display purposes

  // Workflow state transition
  fromStatus String? // null for initial creation
  toStatus   String // "DRAFT", "SUBMITTED", "UNDER_REVIEW", "VALIDATED", "APPROVED", "REJECTED"

  // Action metadata
  action   String // "CREATED", "SUBMITTED", "REVIEWED", "VALIDATED", "APPROVED", "REJECTED", "RETURNED"
  actionBy String // User ID
  actionAt DateTime @default(now())

  // Comments and justification
  comment         String?
  rejectionReason String?

  // Approval metadata
  validatorRole String? // Role of the person performing action
  validatorName String? // Cached name for display

  // Relations
  actionByUser User @relation(fields: [actionBy], references: [id])

  @@index([documentType, documentId])
  @@index([documentType, toStatus])
  @@index([actionBy])
  @@index([actionAt])
  @@map("workflow_history")
}
